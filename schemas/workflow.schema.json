{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/workflow.schema.json",
  "title": "Agent-next Workflow Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "readme", "scope_directory", "phases"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "readme": {"type": "string", "minLength": 1},
    "scope_directory": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "document", "gate"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "document": {"type": "string", "minLength": 1},
          "gate": {"$ref": "#/$defs/gate"}
        }
      }
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_skills": {"$ref": "#/$defs/string_list"},
        "required_skills_any": {"$ref": "#/$defs/string_list"},
        "artifact_types": {"$ref": "#/$defs/string_list"},
        "optional_artifact_types": {"$ref": "#/$defs/string_list"},
        "require_note_prefixes": {"$ref": "#/$defs/string_list"},
        "require_note_prefixes_always": {"$ref": "#/$defs/string_list"},
        "optional": {"type": "boolean"},
        "knowledge": {"type": "boolean"},
        "repository_evidence": {"type": "boolean"},
        "knowledge_plan_resolved": {"type": "boolean"},
        "require_intake_input": {"type": "boolean"},
        "require_bug_intake": {"type": "boolean"},
        "require_environment_target": {"type": "boolean"},
        "require_release_scope_tracks": {"type": "boolean"},
        "traceability": {"type": "boolean"},
        "conditional_artifact_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["note_prefix", "note_contains", "artifact_types"],
            "properties": {
              "note_prefix": {"type": "string", "minLength": 1},
              "note_contains": {"type": "string", "minLength": 1},
              "artifact_types": {"$ref": "#/$defs/string_list"}
            }
          }
        }
      }
    }
  }
}
