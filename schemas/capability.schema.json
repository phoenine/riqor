{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/capability.schema.json",
  "title": "Agent-next Capability",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "workflow", "phase", "skill", "produces", "side_effect", "action_class"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "workflow": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "phase": {"type": "string", "minLength": 1},
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": {"$ref": "#/$defs/artifact-types"},
        "any": {"$ref": "#/$defs/artifact-types"}
      }
    },
    "optional": {"$ref": "#/$defs/artifact-types"},
    "produces": {"$ref": "#/$defs/artifact-types"},
    "side_effect": {"type": "boolean"},
    "action_class": {
      "type": "string",
      "enum": ["local_read", "local_write", "remote_write", "shared_env_execution", "shared_data_mutation"]
    },
    "skill": {"type": "string", "minLength": 1},
    "template": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "cross_scope_inputs": {"type": "boolean", "default": false},
    "extensions": {"type": "object"}
  },
  "$defs": {
    "artifact-types": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}
    }
  }
}
