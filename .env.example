# Agent-next local environment example
# Copy this file to .env and fill in local values. Never commit real credentials.
# `agent-next` loads the repository-root .env without overriding variables that
# are already present in the process environment.

# ZenTao
ZENTAO_BASE_URL=https://zentao.example.local
ZENTAO_PRODUCT_ID=
ZENTAO_USERNAME=
ZENTAO_PASSWORD=
ZENTAO_API_TOKEN=

# GitLab
GITLAB_BASE_URL=https://gitlab.example.local
GITLAB_USERNAME=
GITLAB_PASSWORD=
GITLAB_PRIVATE_TOKEN=
GITLAB_PROJECT_NAMESPACE=

# Lark / Feishu
LARK_APP_ID=
LARK_APP_SECRET=
LARK_TENANT_ACCESS_TOKEN=

# Test server
TEST_SERVER_NAME=
TEST_SERVER_BASE_URL=https://test.example.local
TEST_SERVER_SSH_HOST=
TEST_SERVER_SSH_PORT=22
TEST_SERVER_SSH_USER=
TEST_SERVER_SSH_PASSWORD=
TEST_SERVER_SSH_KEY_PATH=

# PostgreSQL
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USERNAME=
PG_PASSWORD=
PG_SSLMODE=prefer

# ClickHouse
CK_HOST=
CK_PORT=8123
CK_DATABASE=
CK_USERNAME=
CK_PASSWORD=
CK_SECURE=false

# RabbitMQ
RABBITMQ_HOST=
RABBITMQ_MGMT_PORT=15672
RABBITMQ_AMQP_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_QUEUE=

# MageAI
MAGE_BASE_URL=https://mage.example.local
MAGE_USERNAME=
MAGE_PASSWORD=

# Optional services
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Application test account and private project scope
EPVS_TEST_USERNAME=
EPVS_TEST_PASSWORD=
EPVS_TEST_TENANT=
EPVS_TEST_WORKSHOP=
